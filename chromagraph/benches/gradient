# draws a gradient based on `x` and `y`

f_x = x
f_y = y
f_aspect = aspect

c_0 = const 0.0
c_1 = const 1.0
c_2 = const 2.0

# y in [-1, 1] => r in [0, 1]
f_2r = add f_y c_1
f_r = div f_2r c_2

# x in [-aspect, aspect] => g in [0, 1]
f_2ag = add f_x f_aspect
f_2a = mul f_aspect c_2
f_g = div f_2ag f_2a

return f_r f_g c_0
