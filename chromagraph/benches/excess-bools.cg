# a colored threshold pattern that keeps 100 boolean values live

f_x = x
f_y = y
f_x_abs = abs f_x
f_y_abs = abs f_y
f_diamond = add f_x_abs f_y_abs
f_radius_sq_x = mul f_x f_x
f_radius_sq_y = mul f_y f_y
f_radius_sq = add f_radius_sq_x f_radius_sq_y

