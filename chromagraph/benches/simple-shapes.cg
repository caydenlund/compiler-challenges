# draws a square, a circle, a triangle, and a hexagon


# inputs & constants
# ------------------

f_x = x
f_y = y
f_aspect = aspect

c_bg_r = const 0.173
c_bg_g = const 0.243
c_bg_b = const 0.314

c_sq_r = const 0.102
c_sq_g = const 0.737
c_sq_b = const 0.612

c_cir_r = const 0.204
c_cir_g = const 0.596
c_cir_b = const 0.859

c_tri_r = const 0.945
c_tri_g = const 0.769
c_tri_b = const 0.059

c_hex_r = const 0.906
c_hex_g = const 0.298
c_hex_b = const 0.235


# shape positions
# ---------------

c_tri_x = const 0.2
f_tri_x = mul c_tri_x f_aspect
c_hex_x = const 0.6
f_hex_x = mul c_hex_x f_aspect
f_cir_x = neg f_tri_x
f_sq_x = neg f_hex_x


# shapes
# ------

# square centered at (-0.6 * aspect, 0.52)
f_sq_dx = sub f_x f_sq_x
f_sq_dx_abs = abs f_sq_dx
c_sq_y = const 0.52
f_sq_dy = sub f_y c_sq_y
f_sq_dy_abs = abs f_sq_dy
c_sq_half_width = const 0.45
b_sq_in_x = leq f_sq_dx_abs c_sq_half_width
b_sq_in_y = leq f_sq_dy_abs c_sq_half_width
b_sq = and b_sq_in_x b_sq_in_y

# circle centered at (-0.2 * aspect, -0.48)
f_cir_dx = sub f_x f_cir_x
c_cir_y = const -0.48
f_cir_dy = sub f_y c_cir_y
f_cir_dx_sq = mul f_cir_dx f_cir_dx
f_cir_dy_sq = mul f_cir_dy f_cir_dy
f_cir_dist_sq = add f_cir_dx_sq f_cir_dy_sq
c_cir_radius = const 0.50
f_cir_radius_sq = mul c_cir_radius c_cir_radius
b_cir = leq f_cir_dist_sq f_cir_radius_sq

# triangle centered at (0.2 * aspect, 0.30)
f_tri_dx = sub f_x f_tri_x
f_tri_dx_abs = abs f_tri_dx
c_tri_y = const 0.30
f_tri_dy = sub f_y c_tri_y
c_sqrt_3 = const 1.732
f_tri_slant = mul c_sqrt_3 f_tri_dx_abs
f_tri_slant_y = add f_tri_dy f_tri_slant
c_tri_top = const 0.66
c_tri_bottom = const -0.33
b_tri_below_top = leq f_tri_dy c_tri_top
b_tri_above_bottom = leq c_tri_bottom f_tri_dy
b_tri_in_slant = leq f_tri_slant_y c_tri_top
b_tri_in_y = and b_tri_below_top b_tri_above_bottom
b_tri = and b_tri_in_y b_tri_in_slant

# hexagon centered at (0.6 * aspect, -0.38)
f_hex_dx = sub f_x f_hex_x
f_hex_dx_abs = abs f_hex_dx
c_hex_y = const -0.38
f_hex_dy = sub f_y c_hex_y
f_hex_dy_abs = abs f_hex_dy
c_hex_half_width = const 0.60
c_hex_half_height = const 0.52
b_hex_in_x = leq f_hex_dx_abs c_hex_half_width
b_hex_in_y = leq f_hex_dy_abs c_hex_half_height
f_hex_slant_x = mul c_sqrt_3 f_hex_dx_abs
f_hex_slant_sum = add f_hex_slant_x f_hex_dy_abs
c_hex_slant_limit = const 1.04
b_hex_in_slant = leq f_hex_slant_sum c_hex_slant_limit
b_hex_in_box = and b_hex_in_x b_hex_in_y
b_hex = and b_hex_in_box b_hex_in_slant

f_r0 = select b_sq c_sq_r c_bg_r
f_g0 = select b_sq c_sq_g c_bg_g
f_b0 = select b_sq c_sq_b c_bg_b

f_r1 = select b_cir c_cir_r f_r0
f_g1 = select b_cir c_cir_g f_g0
f_b1 = select b_cir c_cir_b f_b0

f_r2 = select b_tri c_tri_r f_r1
f_g2 = select b_tri c_tri_g f_g1
f_b2 = select b_tri c_tri_b f_b1

f_r3 = select b_hex c_hex_r f_r2
f_g3 = select b_hex c_hex_g f_g2
f_b3 = select b_hex c_hex_b f_b2

return f_r3 f_g3 f_b3
